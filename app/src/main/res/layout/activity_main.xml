<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F5FA">

    <TextView
        android:id="@+id/woTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TIME TRAVEL CUSTOMS"
        android:textSize="25sp"
        android:textStyle="bold"
        android:textColor="#172B4D"
        android:layout_marginTop="45dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/woSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Welcome, Traveler!"
        android:textSize="18sp"
        android:textColor="#526581"
        android:layout_marginTop="15dp"
        app:layout_constraintTop_toBottomOf="@id/woTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <EditText
        android:id="@+id/woNom"
        android:layout_width="0dp"
        android:layout_height="55dp"
        android:hint="Full Name"
        android:padding="12dp"
        android:background="#FFFFFF"
        android:layout_marginStart="25dp"
        android:layout_marginEnd="25dp"
        android:layout_marginTop="45dp"
        app:layout_constraintTop_toBottomOf="@id/woSubtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <EditText
        android:id="@+id/woAnneeNaissance"
        android:layout_width="0dp"
        android:layout_height="55dp"
        android:hint="Birth Year"
        android:inputType="number"
        android:padding="12dp"
        android:background="#FFFFFF"
        android:layout_marginStart="25dp"
        android:layout_marginEnd="25dp"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/woNom"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <EditText
        android:id="@+id/woAnneeVoyage"
        android:layout_width="0dp"
        android:layout_height="55dp"
        android:hint="Travel Year"
        android:inputType="number"
        android:padding="12dp"
        android:background="#FFFFFF"
        android:layout_marginStart="25dp"
        android:layout_marginEnd="25dp"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/woAnneeNaissance"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <EditText
        android:id="@+id/woMotif"
        android:layout_width="0dp"
        android:layout_height="55dp"
        android:hint="Motif du voyage"
        android:padding="12dp"
        android:background="#FFFFFF"
        android:layout_marginStart="25dp"
        android:layout_marginEnd="25dp"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/woAnneeVoyage"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/woBtnVerifier"
        android:layout_width="0dp"
        android:layout_height="55dp"
        android:text="VERIFY MY JOURNEY"
        android:textStyle="bold"
        android:layout_marginStart="25dp"
        android:layout_marginEnd="25dp"
        android:layout_marginTop="35dp"
        app:layout_constraintTop_toBottomOf="@id/woMotif"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
